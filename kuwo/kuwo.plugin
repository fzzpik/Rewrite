[Rewrite]
^https?:\/\/mobilead\.kuwo\.cn\/EcomResourceServer\/(getIOSIsHideAd|getMotor)\.do mock-response-body data-type=text data="{}" status-code=200
^https?:\/\/rich\.kuwo\.cn\/(AdService|ecom)\/kaiping\/ad[iI]nfo mock-response-body data-type=text data="{}" status-code=200
^https?:\/\/wapi\.kuwo\.cn\/openapi\/v1\/user\/adVip\/info mock-response-body data-type=text data="{}" status-code=200
^https?:\/\/wapi\.kuwo\.cn\/openapi\/v1\/operate(\/(adVip|freeMode\/h5))?\/text mock-response-body data-type=text data="{}" status-code=200
^https?:\/\/ad\.tencentmusic\.com\/config\/uni mock-response-body data-type=text data=" " status-code=200
^https?:\/\abt-kuwo\.tencentmusic\.com\/kuwo\/ui\/info mock-response-body data-type=text data="{}" status-code=200

[Script]
